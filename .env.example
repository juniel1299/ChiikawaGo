# Local examples only. Replace all three values for any shared environment.
POSTGRES_DB=chii_world
POSTGRES_USER=chii_world
POSTGRES_PASSWORD=local-only-database-password
DJANGO_SECRET_KEY=local-only-django-secret-replace-before-sharing-0123456789
JWT_SIGNING_KEY=local-only-jwt-signing-key-replace-before-sharing-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api,testserver
WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=8000
DB_PORT=5432

# Local-only broker credentials; replace in shared environments.
RABBITMQ_USER=chii_crawler
RABBITMQ_PASSWORD=local-only-rabbitmq-password

# Phase 13: opt-in provider, ADC credentials mounted locally on worker only.
PUSH_ENABLED=false
FIREBASE_PROJECT_ID=
